# Copy this file to `.env` and fill in the values yourself.
# NEVER commit `.env`. NEVER paste the secret into chat (SCOPE §7).
# Get these from https://developer.paypal.com/dashboard/ -> Apps & Credentials
# -> your REST app -> Sandbox tab.

# Sandbox app credentials (required for any LIVE SANDBOX call)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Sandbox API base URL (default is the sandbox host from SCOPE §1)
PAYPAL_API_BASE=https://api-m3.sandbox.paypal.com

# Email of the sandbox BUSINESS test account (the "demo account" the app
# reads: it receives invoices and holds the seeded history). Used by the
# spike runner and the seed drill; the API itself authenticates with the
# client credentials above.
PAYPAL_BUSINESS_EMAIL=

# Email of the sandbox PERSONAL test account (S3 Log in with PayPal test).
PAYPAL_PERSONAL_EMAIL=

# AI model key (DeepSeek) — powers WITNESS extraction, SEATBELT risk
# analysis, and AUDITOR narration. Without it the app still runs: demo-mode
# figures compute deterministically and the AI steps report "not configured"
# honestly instead of inventing output. Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Optional overrides (defaults shown):
# DEEPSEEK_API_BASE=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Flask session secret for the local app (any random string; local only).
FLASK_SECRET_KEY=change-me-local-only
